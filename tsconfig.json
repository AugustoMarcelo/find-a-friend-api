{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["vitest/globals"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "include": ["src", "test"]
}
